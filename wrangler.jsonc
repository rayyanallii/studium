{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "study",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-29",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	// Local development bindings. Freebuff Sites attaches the real DB and FILES
	// bindings on deploy (sites_add_storage), and injects the FREEBUFF_* vars.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "study",
			"database_id": "84ae846f-09b4-4c5a-b63b-52d31886ecc8"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "study-files"
		}
	],
	"observability": {
		"enabled": true
	}
}